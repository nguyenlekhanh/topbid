# ============================================================================
# Environment variables (Task 0.7; production notes per Task 10.1)
#
# Classification:
#   - SERVER-ONLY: never prefixed with NEXT_PUBLIC_; read exclusively inside
#     server-only modules. Never expose to the browser bundle.
#   - PUBLIC: NEXT_PUBLIC_* - inlined into client bundles at build time.
#
# Production (Vercel): set every variable in the Vercel project dashboard
# (Project Settings -> Environment Variables, Production environment) with
# PRODUCTION values. See docs/10.1.txt for the complete manifest and the
# operator-supplied value checklist. Never commit real values anywhere.
# ============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=              # PUBLIC (browser + server clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # PUBLIC (browser + server clients)
SUPABASE_SERVICE_ROLE_KEY=             # SERVER-ONLY (bypasses RLS)

# Stripe
STRIPE_SECRET_KEY=                     # SERVER-ONLY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # PUBLIC
STRIPE_WEBHOOK_SECRET=                 # SERVER-ONLY (webhook signing secret)

# Resend (outbid notifications; server-only)
RESEND_API_KEY=                        # SERVER-ONLY
RESEND_FROM_EMAIL=                     # SERVER-ONLY (verified sender address)

# Outbid notification unsubscribe signing secret (server-only, e.g. openssl rand -hex 32)
UNSUBSCRIBE_SECRET=                    # SERVER-ONLY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000  # PUBLIC (absolute production URL in prod)
